# Caddy: the front door. Gets and renews free HTTPS certificates (Let's Encrypt) for the domain
# automatically and passes everything — web pages, /api and the game WebSocket /ws — to the game
# server on 127.0.0.1. WebSocket upgrades need no extra settings in Caddy.
# DOMAIN and GAME_PORT come from deploy/.env (through docker-compose.yml).

{$DOMAIN} {
	reverse_proxy 127.0.0.1:{$GAME_PORT:7777}
	header Strict-Transport-Security "max-age=31536000"
}

# www.example.com -> example.com (needs a "www" DNS record too; harmless without one)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
