# Settings for deploy/docker-compose.yml. scripts/deploy/setup-server.sh creates the real file,
# deploy/.env, on the server (it is never committed: it holds the dashboard password).

# The address players type, without https:// (DNS must point to this server)
DOMAIN=example.com

# Password for the host dashboard: long random letters/digits (setup-server.sh makes one with
# "openssl rand -hex 24"). Anyone with it AND access to the server could kick/ban players.
DASHBOARD_TOKEN=change-me-to-48-random-hex-characters-xxxxxxxxxx

# Where the database and its backups live on the server
DATA_DIR=/var/lib/lethal-recoil

# Optional
# GAME_PORT=7777
# DASHBOARD_PORT=7778
# LOG_LEVEL=info          (debug | info | warn | error)
# BACKUP_HOURS=24
